# API Keys for External Services
# Copy this file to .env and add your actual API keys

# NewsAPI - Get your free key at https://newsapi.org/
# Used for fetching financial news articles
NEWS_API_KEY=your_newsapi_key_here

# Finnhub API - Get your free key at https://finnhub.io/
# Alternative news source (optional)
FINNHUB_API_KEY=your_finnhub_key_here

# Frontend URLs for CORS (production only)
FRONTEND_URL=https://your-frontend-url.onrender.com
RENDER_EXTERNAL_URL=https://your-backend-url.onrender.com
